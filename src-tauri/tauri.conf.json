{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HIT_ENTER",
  "version": "0.0.0",
  "identifier": "computer.hitenter.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    }
  },
  "app": {
    "windows": [
      {
        "title": "HIT_ENTER",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Self-hosted group chat over a peer-to-peer network",
    "longDescription": "Open-source, self-hosted, local-first group chat. You run the server on your own machine with no port forwarding, and every message is stored in plain text on your disk and on every member's. No cloud, no bots, no telemetry.",
    "publisher": "HIT_ENTER contributors",
    "licenseFile": "../LICENSE-MIT",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/hit-enter.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/hit-enter.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "hitenter"
        ]
      }
    }
  }
}
