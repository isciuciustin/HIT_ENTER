// HIT_ENTER's look, from web/src/app.css: the same ink, panel, edge and
// accent, and JetBrains Mono shipped inside the app (OFL-1.1).
export global Theme {
    out property <color> ink: #0b0d10;
    out property <color> panel: #14181d;
    out property <color> edge: #232a32;
    out property <color> accent: #3ddc84;
    out property <color> accent-ink: #04130a;
    out property <color> text: #e6edf3;
    out property <color> muted: #8b949e;
    out property <color> danger: #f85149;
    out property <length> radius: 6px;
    out property <length> font-size: 14px;
}
