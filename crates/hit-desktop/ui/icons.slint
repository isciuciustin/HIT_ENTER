// Line icons, drawn as vector paths: Lucide's (ISC licence, credited in
// THIRD_PARTY_NOTICES), on its 24-unit grid with its 2-unit stroke.
component Icon inherits Path {
    in property <brush> color: #a3a3a3;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.color;
    stroke-width: root.width / 12;
    stroke-line-cap: round;
}

// lucide "message-circle"
export component ChatIcon inherits Icon {
    commands: "M 7.9 20 A 9 9 0 1 0 4 16.1 L 2 22 Z";
}

// lucide "user"
export component UserIcon inherits Icon {
    commands: "M 19 21 v -2 a 4 4 0 0 0 -4 -4 H 9 a 4 4 0 0 0 -4 4 v 2 M 16 7 a 4 4 0 1 1 -8 0 a 4 4 0 1 1 8 0 Z";
}

// lucide "info"
export component InfoIcon inherits Icon {
    commands: "M 22 12 a 10 10 0 1 1 -20 0 a 10 10 0 1 1 20 0 Z M 12 16 v -4 M 12 8 h 0.01";
}

// lucide "x"
export component CloseIcon inherits Icon {
    commands: "M 18 6 L 6 18 M 6 6 l 12 12";
}

