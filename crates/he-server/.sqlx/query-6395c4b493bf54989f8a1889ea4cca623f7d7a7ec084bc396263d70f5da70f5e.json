  "query": "SELECT m.id            AS \"id!\",\n                      m.channel_id    AS \"channel_id!\",\n                      m.author_id     AS \"author_id!\",\n                      u.username      AS \"author_name!\",\n                      m.content       AS \"content!\",\n                      m.edited_at,\n                      m.deleted_at\n               FROM messages m\n               JOIN users u ON u.id = m.author_id\n               WHERE m.channel_id = ?1 AND m.id > ?2\n               ORDER BY m.id\n               LIMIT ?3",
