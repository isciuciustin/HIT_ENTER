  "query": "SELECT id            AS \"id!\",\n                      channel_id    AS \"channel_id!\",\n                      author_id     AS \"author_id!\",\n                      author_name   AS \"author_name!\",\n                      content       AS \"content!\",\n                      edited_at,\n                      deleted_at\n               FROM cached_messages\n               WHERE endpoint_id = ?1\n                 AND channel_id = ?2\n                 AND (?3 = '' OR id < ?3)\n               ORDER BY id DESC\n               LIMIT ?4",
